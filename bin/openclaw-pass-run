#!/usr/bin/env bash
#
# openclaw-pass-run — launch a stdio MCP server (or any command) with `pass://`
# environment references resolved from Proton Pass.
#
# Usage, as an MCP server entry in openclaw.json:
#
#   {
#     "command": "openclaw-pass-run",
#     "args": ["npx", "-y", "some-mcp-server"],
#     "env": { "SOME_API_KEY": "pass://OpenClaw/some-service/API Key" }
#   }
#
# OpenClaw passes the `pass://` URI through as an ordinary string, so no secret
# is ever written to openclaw.json. `pass-cli run` resolves any environment
# variable whose value is such a URI and hands the real value to the child, so
# the Gateway itself never sees the secret either.
#
# This wrapper exists because two things must be true before `pass-cli run`
# will work unattended, and neither is true by default in a service context:
#
#   1. A session must exist. The Gateway starts at boot, long before any
#      terminal has logged in, so a dedicated `openclaw-gateway` agent token
#      is used. Session bootstrap (including recovery from a stale session or
#      an undecryptable session database) is delegated to
#      openclaw-protonpass-resolver --ensure-session so there is one
#      implementation rather than two.
#
#   2. Agent tokens refuse audited reads unless PROTON_PASS_AGENT_REASON is
#      set. Every resolution here is attributable in
#      `pass-cli agent monitor openclaw-gateway`, so the reason names the
#      command being launched rather than a generic string.
#
# Environment overrides (all optional):
#
#   PASS_CLI                          path to the pass-cli binary
#   OPENCLAW_PROTONPASS_RESOLVER      path to openclaw-protonpass-resolver
#   PROTON_PASS_SESSION_DIR           session directory for this provider

set -euo pipefail

HERE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

# PATH first so the binary can be overridden without editing anything, then the
# locations the Proton Pass installer uses: a service unit often runs with a
# minimal PATH, which is why the explicit fallbacks exist at all.
find_pass_cli() {
    if [ -n "${PASS_CLI:-}" ]; then printf '%s\n' "$PASS_CLI"; return 0; fi
    if command -v pass-cli >/dev/null 2>&1; then command -v pass-cli; return 0; fi
    for candidate in "$HOME/.local/bin/pass-cli" /usr/local/bin/pass-cli /usr/bin/pass-cli; do
        [ -x "$candidate" ] && { printf '%s\n' "$candidate"; return 0; }
    done
    printf 'pass-cli\n'
}

# The installed layout puts both scripts in the same directory, so a sibling
# lookup comes before PATH: a non-default install prefix then works with no
# configuration, and cannot pick up a different copy that shadows it on PATH.
find_resolver() {
    if [ -n "${OPENCLAW_PROTONPASS_RESOLVER:-}" ]; then
        printf '%s\n' "$OPENCLAW_PROTONPASS_RESOLVER"; return 0
    fi
    if [ -x "$HERE/openclaw-protonpass-resolver" ]; then
        printf '%s\n' "$HERE/openclaw-protonpass-resolver"; return 0
    fi
    if command -v openclaw-protonpass-resolver >/dev/null 2>&1; then
        command -v openclaw-protonpass-resolver; return 0
    fi
    printf '%s\n' "$HOME/.local/bin/openclaw-protonpass-resolver"
}

PASS="$(find_pass_cli)"
RESOLVER="$(find_resolver)"
SESSION_DIR="${PROTON_PASS_SESSION_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/openclaw-protonpass}"

if [ "$#" -eq 0 ]; then
    echo "openclaw-pass-run: no command given" 1>&2
    echo "usage: openclaw-pass-run <command> [args...]" 1>&2
    exit 64
fi

# Tolerate an explicit `--` separator so the invocation can mirror `pass-cli run`.
if [ "${1:-}" = "--" ]; then
    shift
    if [ "$#" -eq 0 ]; then
        echo "openclaw-pass-run: no command after --" 1>&2
        exit 64
    fi
fi

export PROTON_PASS_SESSION_DIR="$SESSION_DIR"
export PROTON_PASS_AGENT_REASON="${PROTON_PASS_AGENT_REASON:-MCP server launch: $1}"

if ! "$RESOLVER" --ensure-session >/dev/null 2>&1; then
    echo "openclaw-pass-run: could not establish a Proton Pass agent session" 1>&2
    echo "  check: PROTON_PASS_SESSION_DIR=$SESSION_DIR $PASS info" 1>&2
    exit 69
fi

# exec so the MCP server inherits this process: OpenClaw manages a stdio server
# by its pid and its stdin/stdout, and an extra shell in between would break
# both signal delivery and the transport.
exec "$PASS" run -- "$@"
