#!/usr/bin/env python3
"""
openclaw-mcp-auth-proxy — inject Proton Pass credentials into remote MCP requests.

A remote MCP server is reached by OpenClaw over HTTPS directly, with no process
in between, so a `pass://` reference placed in `mcp.servers.<id>.headers` would
be transmitted verbatim rather than resolved. OpenClaw also rejects SecretRefs in
that field (every source: exec, store and env), so the only value it will accept
there is a literal string. Writing the real key into openclaw.json is the thing
we are avoiding.

This proxy supplies the missing hop. OpenClaw is pointed at a loopback route
here; the proxy resolves the credential from Proton Pass at request time,
injects it as a header, and streams the upstream response straight back. The
secret exists only in this process's memory, never in configuration.

Configuration (CONFIG_PATH), routes keyed by local path:

    {
      "listen": "127.0.0.1:18890",
      "routes": {
        "/dex": {
          "upstream": "https://mcp.getdex.com/mcp",
          "header":   "Authorization",
          "secretId": "DEX_MCP_AUTHORIZATION"
        }
      }
    }

`secretId` is an id from the resolver's secret map rather than a `pass://` URI,
so this file never records a vault path either.

Environment overrides (all optional):

  OPENCLAW_MCP_PROXY_CONFIG        path to the route configuration above
  OPENCLAW_PROTONPASS_RESOLVER     path to openclaw-protonpass-resolver
"""

import http.client
import json
import os
import shutil
import subprocess
import sys
import threading
import urllib.parse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

XDG_CONFIG = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")


def find_resolver():
    """Locate the resolver this proxy delegates credential lookups to.

    The installed layout puts both scripts in the same directory, so a sibling
    lookup is tried before PATH: that keeps a non-default install prefix working
    without any configuration, and without picking up a different copy that
    happens to be on PATH first.
    """
    override = os.environ.get("OPENCLAW_PROTONPASS_RESOLVER")
    if override:
        return override

    sibling = os.path.join(
        os.path.dirname(os.path.abspath(__file__)), "openclaw-protonpass-resolver"
    )
    if os.path.isfile(sibling) and os.access(sibling, os.X_OK):
        return sibling

    found = shutil.which("openclaw-protonpass-resolver")
    if found:
        return found

    return os.path.expanduser("~/.local/bin/openclaw-protonpass-resolver")


RESOLVER = find_resolver()
CONFIG_PATH = os.environ.get(
    "OPENCLAW_MCP_PROXY_CONFIG",
    os.path.join(XDG_CONFIG, "proton-pass-cli", "openclaw-mcp-proxy.json"),
)

# Headers that describe a single hop and must not be forwarded across one.
HOP_BY_HOP = {
    "connection",
    "keep-alive",
    "proxy-authenticate",
    "proxy-authorization",
    "te",
    "trailers",
    "transfer-encoding",
    "upgrade",
}

_cache = {}
_cache_lock = threading.Lock()


def log(message):
    sys.stderr.write(f"[mcp-auth-proxy] {message}\n")
    sys.stderr.flush()


def resolve_secret(secret_id, refresh=False):
    """Fetch one secret by id, memoised until a refresh is demanded.

    Re-resolving on every request would mean a vault round trip per MCP call;
    caching means a rotated credential would otherwise never be picked up, so
    an upstream 401 forces a refresh.
    """
    with _cache_lock:
        if not refresh and secret_id in _cache:
            return _cache[secret_id]

    request = json.dumps(
        {"protocolVersion": 1, "provider": "protonpass", "ids": [secret_id]}
    ).encode()
    proc = subprocess.run([RESOLVER], input=request, capture_output=True, timeout=90)
    if proc.returncode != 0:
        raise RuntimeError(
            f"resolver exited {proc.returncode}: "
            f"{proc.stderr.decode('utf8', 'replace').strip()[:200]}"
        )

    payload = json.loads(proc.stdout.decode("utf8", "replace"))
    if payload.get("error"):
        raise RuntimeError(payload["error"])
    value = (payload.get("values") or {}).get(secret_id)
    if not value:
        raise RuntimeError(f"resolver returned no value for {secret_id}")

    with _cache_lock:
        _cache[secret_id] = value
    return value


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "openclaw-mcp-auth-proxy"

    # BaseHTTPRequestHandler logs every request to stderr; keep the service quiet
    # and log only what matters.
    def log_message(self, fmt, *args):
        pass

    def _route(self):
        path = urllib.parse.urlparse(self.path).path.rstrip("/") or "/"
        routes = self.server.routes
        return routes.get(path) or routes.get(path + "/")

    def _fail(self, status, message):
        body = json.dumps({"error": message}).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Connection", "close")
        self.end_headers()
        self.wfile.write(body)

    def _forward(self, method):
        route = self._route()
        if route is None:
            self._fail(404, f"no route for {self.path}")
            return

        length = int(self.headers.get("Content-Length") or 0)
        body = self.rfile.read(length) if length else b""

        try:
            self._attempt(method, route, body, refresh=False)
        except Unauthorized:
            # The cached credential was stale or rotated; resolve again once.
            log(f"{route['upstream']} returned 401, refreshing credential")
            try:
                self._attempt(method, route, body, refresh=True)
            except Unauthorized:
                self._fail(401, "upstream rejected the credential after refresh")
            except Exception as exc:
                self._fail(502, f"upstream error: {exc}")
        except Exception as exc:
            self._fail(502, f"upstream error: {exc}")

    def _attempt(self, method, route, body, refresh):
        secret = resolve_secret(route["secretId"], refresh=refresh)
        target = urllib.parse.urlparse(route["upstream"])

        outbound = {}
        for name, value in self.headers.items():
            if name.lower() in HOP_BY_HOP or name.lower() in ("host", "content-length"):
                continue
            outbound[name] = value
        outbound["Host"] = target.netloc
        outbound[route.get("header", "Authorization")] = secret
        if body:
            outbound["Content-Length"] = str(len(body))

        conn_cls = (
            http.client.HTTPSConnection
            if target.scheme == "https"
            else http.client.HTTPConnection
        )
        conn = conn_cls(target.netloc, timeout=route.get("timeoutSeconds", 120))
        try:
            path = target.path or "/"
            if target.query:
                path += "?" + target.query
            conn.request(method, path, body=body or None, headers=outbound)
            response = conn.getresponse()

            # Distinguish a rejected credential from a genuine application error
            # so the retry only fires when re-resolving could actually help.
            if response.status == 401 and not refresh:
                response.read()
                raise Unauthorized()

            self.send_response(response.status)
            for name, value in response.getheaders():
                if name.lower() in HOP_BY_HOP or name.lower() == "content-length":
                    continue
                self.send_header(name, value)
            # The response may be an open text/event-stream of unknown length, so
            # framing is "read until close" rather than a declared length.
            self.send_header("Connection", "close")
            self.end_headers()

            # read1 returns whatever has arrived instead of waiting for a full
            # buffer, which is what keeps server-sent events flowing promptly
            # rather than surfacing in batches.
            while True:
                chunk = response.read1(65536)
                if not chunk:
                    break
                self.wfile.write(chunk)
                self.wfile.flush()
        finally:
            conn.close()

    def do_POST(self):
        self._forward("POST")

    def do_GET(self):
        self._forward("GET")

    def do_DELETE(self):
        self._forward("DELETE")


class Unauthorized(Exception):
    pass


def main():
    try:
        with open(CONFIG_PATH) as handle:
            config = json.load(handle)
    except Exception as exc:
        log(f"could not read {CONFIG_PATH}: {exc}")
        return 1

    routes = config.get("routes") or {}
    if not routes:
        log("no routes configured; nothing to serve")
        return 1

    listen = config.get("listen", "127.0.0.1:18890")
    host, _, port = listen.rpartition(":")
    host = host or "127.0.0.1"

    if host not in ("127.0.0.1", "::1", "localhost"):
        # Binding beyond loopback would expose an unauthenticated route that
        # attaches a real credential to anything that reaches it.
        log(f"refusing to bind {host}: this proxy is loopback-only by design")
        return 1

    server = ThreadingHTTPServer((host, int(port)), Handler)
    server.routes = routes
    log(f"listening on {host}:{port}; routes: {', '.join(sorted(routes))}")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
