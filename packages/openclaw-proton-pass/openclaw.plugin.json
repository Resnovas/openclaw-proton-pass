{
  "id": "proton-pass",
  "name": "Proton Pass",
  "description": "Resolve OpenClaw credentials from Proton Pass at request time. Secrets stay in the vault; openclaw.json records only opaque ids.",
  "version": "1.0.2",
  "homepage": "https://github.com/Resnovas/openclaw-proton-pass",
  "categories": [
    "security"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false
  },
  "activation": {
    "onStartup": false
  },
  "secretProviderIntegrations": {
    "proton-pass": {
      "providerAlias": "protonpass",
      "displayName": "Proton Pass",
      "source": "exec",
      "command": "${node}",
      "args": [
        "./bin/openclaw-protonpass-resolver.mjs"
      ],
      "jsonOnly": true,
      "timeoutMs": 60000,
      "passEnv": [
        "PATH",
        "HOME",
        "OPENCLAW_PROTONPASS_AGENT_TOKEN",
        "XDG_CONFIG_HOME",
        "XDG_STATE_HOME",
        "PASS_CLI",
        "USERPROFILE",
        "APPDATA",
        "LOCALAPPDATA",
        "PATHEXT",
        "OPENCLAW_PROTONPASS_AUDIT_LABEL",
        "OPENCLAW_PROFILE"
      ]
    }
  }
}
