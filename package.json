{
  "name": "@resnovas/openclaw-proton-pass",
  "version": "0.1.0",
  "private": true,
  "description": "Resolve OpenClaw credentials from Proton Pass at request time",
  "license": "LicenseRef-FCL-1.0-MIT",
  "author": "Jonathan Stevens T/A Resnovas <hello@resnovas.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Resnovas/openclaw-proton-pass.git"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "build": "nx run-many -t build",
    "check": "nx run-many -t check",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "coverage:depth": "node --experimental-strip-types scripts/coverage-depth.ts",
    "lint:headers": "node --experimental-strip-types scripts/check-headers.ts",
    "lint:prose": "node --experimental-strip-types scripts/check-prose.ts",
    "lint:contracts": "node --experimental-strip-types scripts/check-contracts.ts",
    "ai-docgen": "node --experimental-strip-types scripts/ai-docgen.ts",
    "ai-docgen:check": "node --experimental-strip-types scripts/ai-docgen.ts --check",
    "docs:api": "node --experimental-strip-types scripts/docs-api.ts",
    "docs:check": "node --experimental-strip-types scripts/docs-api.ts --check",
    "docs:dev": "cd docs && pnpm dlx mint@4.2.908 dev --port 3333",
    "docs:dev:docs7": "docs7 dev ./docs --port 3334",
    "docs:deploy": "docs7 deploy ./docs",
    "verify": "pnpm check && pnpm lint:headers && pnpm lint:prose && pnpm lint:contracts && pnpm coverage && pnpm coverage:depth && pnpm docs:check && pnpm ai-docgen:check"
  },
  "devDependencies": {
    "@effect/docgen": "0.5.2",
    "@effect/platform": "^0.97.2",
    "@effect/platform-node": "^0.108.2",
    "@effect/vitest": "^0.30.0",
    "@nx/js": "^23.2.1",
    "@resnovas/opp-domain": "workspace:*",
    "@resnovas/opp-telemetry": "workspace:*",
    "@types/node": "^24.0.0",
    "@upstash/docs7": "^0.1.10",
    "@vitest/coverage-v8": "^3.2.7",
    "effect": "^3.22.2",
    "esbuild": "^0.28.2",
    "nx": "^23.2.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
