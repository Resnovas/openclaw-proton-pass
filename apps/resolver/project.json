{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "resolver",
  "projectType": "application",
  "sourceRoot": "apps/resolver/src",
  "tags": [
    "type:app",
    "scope:cli"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -b apps/resolver/tsconfig.json"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -b apps/resolver/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run tests/apps/resolver --passWithNoTests",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
