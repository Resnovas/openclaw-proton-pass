{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "onepassword-compat",
  "projectType": "library",
  "sourceRoot": "libs/onepassword-compat/src",
  "tags": [
    "type:service",
    "scope:shared",
    "type_extension",
    "layer_backend"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -b libs/onepassword-compat/tsconfig.json"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -b libs/onepassword-compat/tsconfig.json --noEmit false"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run tests/libs/onepassword-compat --passWithNoTests",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
