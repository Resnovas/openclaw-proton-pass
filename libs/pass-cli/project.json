{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "pass-cli",
  "projectType": "library",
  "sourceRoot": "libs/pass-cli/src",
  "tags": [
    "type:service",
    "scope:shared"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -b libs/pass-cli/tsconfig.json"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -b libs/pass-cli/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run tests/libs/pass-cli --passWithNoTests",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
