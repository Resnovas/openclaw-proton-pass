{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "config",
  "projectType": "library",
  "sourceRoot": "libs/config/src",
  "tags": [
    "type:config",
    "scope:shared"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -b libs/config/tsconfig.json"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -b libs/config/tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run tests/libs/config --passWithNoTests",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
