{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "domain",
  "projectType": "library",
  "sourceRoot": "libs/domain/src",
  "tags": [
    "type:domain",
    "scope:shared"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -b libs/domain/tsconfig.json"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -b libs/domain/tsconfig.json --noEmit false"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run tests/libs/domain --passWithNoTests",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
